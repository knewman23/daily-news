# Anchored to the root: a bare `data/` also matches site/data/, which silently
# excluded the exported site's JSON and published an empty page.
/data/
/logs/
__pycache__/
*.pyc
.venv/
venv/
*.session
.DS_Store

# Journal notes live inside news/*.md, so the raw digests stay local.
# Only the generated site/ (which renders the news body without notes) is published.
news/
